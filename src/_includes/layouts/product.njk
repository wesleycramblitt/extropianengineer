{% extends "layouts/base.njk" %}
{%- block head %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Product","name":"{{ title }}","description":"{{ tagline }}","url":"{{ site.url }}{{ page.url }}","brand":{"@type":"Brand","name":"Extropian"}}
</script>
{%- endblock %}
{%- block main %}
<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> / <a href="/products/">Products</a> / <span>{{ title }}</span>
</nav>
<header class="page-hero">
  <h1 data-scramble>{{ title }}</h1>
  {%- if type or category %}
  <div class="badge-table">
    {%- if type %}
    <div class="badge-line"><span class="badge-label">Type:</span><span class="badge-row"><span class="badge badge--type badge-val-{{ type | badgeClass }}">{{ type }}</span></span></div>
    {%- endif %}
    {%- if category and category.length %}
    <div class="badge-line"><span class="badge-label">{% if category.length > 1 %}Categories:{% else %}Category:{% endif %}</span><span class="badge-row">{%- for c in category %}<span class="badge badge--cat badge-val-{{ c }}">{{ c | catName }}</span>{% endfor %}</span></div>
    {%- endif %}
  </div>
  {%- endif %}
  <p class="lede">{{ tagline }}</p>
</header>

{%- set singleMedia = [media] if media else [] -%}
{%- set frames = gallery or singleMedia -%}
{%- if frames and frames.length > 0 %}
<div class="wrap">
  <div class="pb-slideshow product-gallery" data-autoplay="true">
    <div class="pb-frames">
      {%- for frame in frames %}
      {%- if frame.type == 'video' %}
      <div class="pb-frame"><video muted loop playsinline preload="metadata" poster="{{ frame.poster or '' }}"><source src="{{ frame.src }}"></video></div>
      {%- elif frame.type == 'image' %}
      <div class="pb-frame"><img src="{{ frame.src }}" alt="{{ title }} — {{ tagline }}"></div>
      {%- endif %}
      {%- endfor %}
    </div>
    {%- if frames.length > 1 %}
    <button type="button" class="pb-arrow pb-prev" aria-label="Previous image">‹</button>
    <button type="button" class="pb-arrow pb-next" aria-label="Next image">›</button>
    <div class="pb-dots"></div>
    <span class="pb-frame-count"></span>
    {%- endif %}
  </div>
</div>
{%- else %}
<div class="wrap">
  <div class="pcard-visual product-band pv-{{ category[0] }}" aria-hidden="true">
    <span class="pv-glyph">{{ title | glyph }}</span>
    <span class="pv-note">Interactive demonstration coming soon</span>
  </div>
</div>
{%- endif %}

<article class="wrap-narrow section-block">
  {{ product.body | markdown | safe }}
</article>

{%- if capabilities and capabilities.length %}
<section class="wrap section-block" id="capabilities">
  <div class="section-top"><h2>Core capabilities</h2></div>
  <div class="wrap-narrow">
    <ul class="tick-list">
    {%- for c in capabilities %}
      <li>{{ c }}</li>
    {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}

{%- if foundation and foundation.length %}
<section class="wrap section-block" id="foundation">
  <div class="section-top"><h2>Technical foundation</h2></div>
  <div class="wrap-narrow">
    <ul class="tick-list">
    {%- for f in foundation %}
      <li>{{ f }}</li>
    {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}

{%- if (uses and uses.length) or (usedBy and usedBy.length) %}
<section class="wrap section-block" id="ecosystem">
  <div class="section-top"><h2>Ecosystem connections</h2></div>
  <div class="wrap-narrow">
    {%- if uses and uses.length %}
    <p class="muted">Uses:</p>
    <div class="chip-row">
      {%- for slug in uses %}
      <a class="chip" href="/products/{{ slug }}/">{{ collections.products | findTitle(slug) }}</a>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- if usedBy and usedBy.length %}
    <p class="muted">Used by:</p>
    <div class="chip-row">
      {%- for slug in usedBy %}
      <a class="chip" href="/products/{{ slug }}/">{{ collections.products | findTitle(slug) }}</a>
      {%- endfor %}
    </div>
    {%- endif %}
  </div>
</section>
{%- endif %}

<section class="wrap section-block" id="licensing">
  <div class="section-top"><h2>Licensing &amp; customization</h2></div>
  <div class="wrap-narrow">
    {%- if licensing and licensing.length %}
    <p class="badge-row" style="margin-bottom:0.9em;">
      {%- for lic in licensing %}<span class="badge badge--license badge-val-{{ lic | badgeClass }}">{{ lic }}</span>{% endfor %}
    </p>
    {%- endif %}
    <p>Licensing is negotiated around the software, deployment model, scope, and ownership requirements of each project — whether {{ title }} is used as-is, customized for your workflows, or embedded in a larger system you are building. I prefer perpetual licenses per major version: one fee licenses the version you chose for as long as you use it, with maintenance updates included within that major version.</p>
    {%- for lic in licensing %}
    {%- if lic == 'Open Source (Apache 2.0)' %}
    <p><strong>Open Source (Apache 2.0):</strong> free to use, modify, and distribute — including in commercial products — with attribution.</p>
    {%- elif lic == 'Source Available (PolyForm Shield)' %}
    <p><strong>Source Available (PolyForm Shield):</strong> view and build from the source under terms that prevent offering it as a competing product or service — no license fees or royalties.</p>
    {%- elif lic == 'Binary Distribution (Proprietary)' %}
    <p><strong>Binary Distribution (Proprietary):</strong> one-time license to use and distribute the software in binary form, including inside products you sell.</p>
    {%- elif lic == 'Internal Use (Proprietary)' %}
    <p><strong>Internal Use (Proprietary):</strong> one-time license for ongoing internal use of the software as delivered — no distribution, no recurring fees.</p>
    {%- endif %}
    {%- endfor %}
    <div class="cta-row">
      <a class="button button--green" href="mailto:{{ site.email }}?subject={{ ('Licensing%20inquiry%3A%20' ~ title) | urlencode | safe }}">Discuss licensing →</a>
      <a class="button button--ghost" href="/engineering/">All services &amp; licensing options</a>
    </div>
  </div>
</section>

<section class="contact-band">
  <h2>Start a conversation</h2>
  <p class="normal">Tell me about your workflow and deployment — I respond within 24 hours.</p>
  <p><a class="email-big" href="mailto:{{ site.email }}">{{ site.email }}</a></p>
</section>
{%- endblock %}
