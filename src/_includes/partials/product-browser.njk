{# ────────────────────────────────────────────────────────────────
   Product browser component
   Usage: {% from "partials/product-browser.njk" import productBrowser %}
          {{ productBrowser(collections.productsByOrder, 'pb-home', true) }}
   Params: itemList (ordered collection pages), id (unique), featuredOnly (bool)
   ──────────────────────────────────────────────────────────────── #}
{% macro pbGradientFrame(item) %}
<div class="pb-frame pb-frame--gradient pv-{{ (item.data.category)[0] }}">
  <span class="pv-glyph">{{ item.data.title | glyph }}</span>
  <span class="pv-note">Interactive demonstration coming soon</span>
</div>
{% endmacro %}

{% macro pbMediaFrames(item, frames) %}
  {%- if not frames -%}
    {%- set singleMedia = [item.data.media] if item.data.media else [] -%}
    {%- set frames = item.data.gallery or singleMedia -%}
  {%- endif -%}
  {%- for frame in frames -%}
    {%- if frame.type == 'video' %}
<div class="pb-frame"><video muted loop playsinline preload="metadata" poster="{{ frame.poster or '' }}"><source src="{{ frame.src }}"></video>{% if frame.caption %}<span class="pb-caption">{{ frame.caption }}</span>{% endif %}</div>
    {%- elif frame.type == 'image' %}
<div class="pb-frame"><img src="{{ frame.src }}" alt="{{ item.data.title }}{% if frame.caption %} — {{ frame.caption }}{% endif %}" loading="lazy">{% if frame.caption %}<span class="pb-caption">{{ frame.caption }}</span>{% endif %}</div>
    {%- endif -%}
  {%- endfor -%}
{% endmacro %}

{% macro productBrowser(itemList, id, featuredOnly, showFilters) %}
{%- if showFilters == undefined %}{% set showFilters = true %}{% endif %}
<div class="product-browser" id="{{ id }}" data-pb>
  <div class="pb-toolbar{% if showFilters == false %} pb-toolbar--min{% endif %}">
    {%- if showFilters != false %}
    <div class="pb-chips" role="group" aria-label="Filter by category">
      <button type="button" class="pb-chip is-on" data-pb-cat="">All</button>
      {%- for cat in itemList | pbCats(featuredOnly) %}
      <button type="button" class="pb-chip" data-pb-cat="{{ cat.key }}">{{ cat.name }}</button>
      {%- endfor %}
    </div>
    <input class="pb-search" type="search" placeholder="Search products…" aria-label="Search products">
    {%- endif %}
    <span class="pb-count" data-pb-count></span>
  </div>

  <div class="pb-layout">
    <div class="pb-list" aria-label="Products">
      {%- for item in itemList %}
      {%- if not featuredOnly or item.data.featuredOnHome %}
      <button type="button" class="pb-item" data-pb-slug="{{ item.data.slug }}"
        data-pb-cat="{{ item.data.category | join(' ') }}"
        data-pb-search="{{ (item.data.title ~ ' ' ~ item.data.tagline) | lower }}"
        aria-pressed="false">
        {%- set singleMedia = [item.data.media] if item.data.media else [] -%}
        {%- set manualGallery = item.data.gallery or [] -%}
        {%- set autoGallery = gallery[item.data.slug] if (gallery and gallery[item.data.slug]) else [] -%}
        {%- set frames = manualGallery if manualGallery.length else (autoGallery if autoGallery.length else singleMedia) -%}
        {%- set thumb = frames[0] if frames.length else none -%}
        <span class="pb-item-glyph pv-{{ (item.data.category)[0] }}">{% if thumb and thumb.type == 'image' %}<img src="{{ thumb.src }}" alt="" loading="lazy">{% elif thumb and thumb.poster %}<img src="{{ thumb.poster }}" alt="" loading="lazy">{% else %}{{ item.data.title | glyph }}{% endif %}</span>
        <span class="pb-item-text">
          <span class="pb-item-name">{{ item.data.title }}</span>
          {%- if item.data.type %}
          <span class="pb-item-type"><span class="badge badge--type badge-val-{{ item.data.type | badgeClass }}">{{ item.data.type }}</span></span>
          {%- endif %}
        </span>
      </button>
      {%- endif %}
      {%- endfor %}
    </div>

    <div class="pb-stage">
      {%- for item in itemList %}
      {%- if not featuredOnly or item.data.featuredOnHome %}
      {%- set singleMedia = [item.data.media] if item.data.media else [] -%}
      {%- set manualGallery = item.data.gallery or [] -%}
      {%- set autoGallery = gallery[item.data.slug] if (gallery and gallery[item.data.slug]) else [] -%}
      {%- set frames = manualGallery if manualGallery.length else (autoGallery if autoGallery.length else singleMedia) -%}
      <article class="pb-panel" data-pb-panel="{{ item.data.slug }}"
        data-pb-cat="{{ item.data.category | join(' ') }}"
        data-pb-search="{{ (item.data.title ~ ' ' ~ item.data.tagline) | lower }}"
        aria-label="{{ item.data.title }}">
        <div class="pb-slideshow">
          <div class="pb-frames">
            {%- if frames and frames.length > 0 %}
              {{ pbMediaFrames(item, frames) }}
            {%- else %}
              {{ pbGradientFrame(item) }}
            {%- endif %}
          </div>
          {%- if frames and frames.length > 1 %}
          <button type="button" class="pb-arrow pb-prev" aria-label="Previous image">‹</button>
          <button type="button" class="pb-arrow pb-next" aria-label="Next image">›</button>
          <div class="pb-dots"></div>
          <span class="pb-frame-count"></span>
          {%- endif %}
        </div>
        <div class="pb-panel-body">
          <h3>{{ item.data.title }}</h3>
          <div class="badge-row">
            {%- if item.data.type %}<span class="badge badge--type badge-val-{{ item.data.type | badgeClass }}">{{ item.data.type }}</span>{% endif %}
            {%- for c in item.data.category %}<span class="badge badge--cat badge-val-{{ c }}">{{ c | catName }}</span>{% endfor %}
            {%- if item.data.status %}<span class="badge badge--status badge-val-status-{{ item.data.status | badgeClass }}">{{ item.data.status }}</span>{% endif %}
          </div>
          <p class="pb-tagline">{{ item.data.tagline }}</p>
          <a class="button button--ghost pb-details" href="{{ item.url }}">Full details →</a>
        </div>
      </article>
      {%- endif %}
      {%- endfor %}
    </div>
  </div>
</div>
{% endmacro %}
